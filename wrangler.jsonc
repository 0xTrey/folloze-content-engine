{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folloze-blog",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "assets": {
    "directory": "./site/cloudflare-production",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
