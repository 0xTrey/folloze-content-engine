{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "{{ title }}",
      "description": "{{ meta_description }}",
      "author": {
        "@type": "Organization",
        "name": "Folloze",
        "url": "https://www.folloze.com"
      },
      "datePublished": "{{ date_published }}",
      "dateModified": "{{ date_published }}",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ canonical_url }}"
      },
      "keywords": "{{ keywords_csv }}"
    },
    {
      "@type": "FAQPage",
      "mainEntity": {{ faq_items_json }}
    }
  ]
}

